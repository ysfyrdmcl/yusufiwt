#include "Base.xcconfig"
#include? "Local.xcconfig"

AGENTCONTROL_ENV = mac-local-v1
AGENTCONTROL_ALLOW_DEBUG_FEATURES = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) RELEASE AGENTCONTROL_MAC_LOCAL

FEATURE_REMOTE_MODE = NO
FEATURE_SSH = NO
FEATURE_WATCH = NO
FEATURE_DIRECT_LAN = NO
FEATURE_TELEMETRY = NO
FEATURE_IOS_COMPANION = NO
FEATURE_RELAY = NO
FEATURE_APNS = NO
FEATURE_SPARKLE = NO
FEATURE_CODEX_MANAGED_SESSION = NO

ENABLE_HARDENED_RUNTIME = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
GCC_GENERATE_DEBUGGING_SYMBOLS = YES
STRIP_INSTALLED_PRODUCT = NO
COPY_PHASE_STRIP = NO
VALIDATE_PRODUCT = YES
