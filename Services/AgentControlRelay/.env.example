APP_ENV=development
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://agentcontrol:agentcontrol@postgres:5432/agentcontrol
REDIS_URL=redis://redis:6379
JWT_SIGNING_PRIVATE_KEY_B64=example-required
TOKEN_HASH_PEPPER=example-required
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PAIRING_TTL_SECONDS=300
ENVELOPE_TTL_SECONDS=600
MAX_ENVELOPE_BYTES=65536
MAX_PENDING_ENVELOPES_PER_DEVICE=1000
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SIWA_ALLOWED_AUDIENCES=com.yusuf.agentcontrol.ios,com.yusuf.agentcontrol.service
APNS_KEY_ID=example-required
APNS_TEAM_ID=example-required
APNS_PRIVATE_KEY_B64=example-required
APNS_TOPIC=com.yusuf.agentcontrol.ios
APNS_LIVE_ACTIVITY_TOPIC=com.yusuf.agentcontrol.ios.push-type.liveactivity
APNS_ENVIRONMENT=sandbox
DATA_RETENTION_HOURS=24
METRICS_BEARER_TOKEN=example-required
EMERGENCY_DISABLE_PAIRING=0
EMERGENCY_DISABLE_ENVELOPE_SUBMISSION=0
EMERGENCY_DISABLE_APNS=0
EMERGENCY_DISABLE_LIVE_ACTIVITIES=0
