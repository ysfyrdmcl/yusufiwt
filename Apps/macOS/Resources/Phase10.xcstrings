    "onboarding.navigation.optional" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You can skip these permissions. AgentControl will activate the application or open the project folder instead." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu izinleri atlayabilirsiniz. AgentControl bunun yerine uygulamayı veya proje klasörünü açar." } } } },
