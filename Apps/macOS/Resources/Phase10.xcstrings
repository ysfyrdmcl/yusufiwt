    "onboarding.discovery.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Detection only checks installed applications and agent version commands." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Algılama yalnız kurulu uygulamaları ve agent sürüm komutlarını kontrol eder." } } } },
