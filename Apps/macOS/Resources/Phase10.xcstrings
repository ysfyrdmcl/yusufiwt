    "onboarding.review.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only marked AgentControl hook entries are added. All selected files are installed atomically after this review." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yalnız işaretli AgentControl hook kayıtları eklenir. Seçili dosyalar bu incelemeden sonra atomik kurulur." } } } },
