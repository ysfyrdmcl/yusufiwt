    "onboarding.core.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS may ask you to approve the user-level helper and notifications. No root access is requested." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "macOS kullanıcı düzeyi helper ve bildirimler için onay isteyebilir. Root erişimi istenmez." } } } },
