    "onboarding.navigation.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility and Automation are used only to reveal a specific pane. AgentControl checks permission without prompting during normal navigation." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Erişilebilirlik ve Otomasyon yalnız belirli bir bölmeyi göstermek için kullanılır. AgentControl normal yönlendirmede izni istem açmadan kontrol eder." } } } },
    "onboarding.navigation.accessibility" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Accessibility Fallback" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Erişilebilirlik Fallback'ini Etkinleştir" } } } },
